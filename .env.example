# Bank Licensing & Compliance Portal — environment template.
# Copy to .env (which is gitignored) and adjust as needed.

# ── Database ────────────────────────────────────────────────────────────
# Two roles, by design:
#   bnr_admin: superuser-like, used ONLY for migrations/seeds at deploy time.
#   bnr_app:   restricted runtime role. Has SELECT+INSERT on AuditLog
#              (no UPDATE/DELETE). The application connects with this role.
# This is what makes the audit log immutable at the DB level.
DATABASE_ADMIN_URL=postgresql://bnr_admin:admin_pw_change_me@localhost:5434/bnr_portal
DATABASE_URL=postgresql://bnr_app:app_pw_change_me@localhost:5434/bnr_portal

# ── Auth ────────────────────────────────────────────────────────────────
# Must be at least 32 bytes. The app refuses to start with a weaker secret.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-secure-32-byte-random-string-please-use-openssl

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Frontend origin allowed to send credentialed requests (CORS).
# Wildcards are forbidden when using cookie auth.
FRONTEND_ORIGIN=http://localhost:3001

# ── Storage ─────────────────────────────────────────────────────────────
# Where uploaded documents are written (relative to apps/api/).
# Spec calls for simulated local storage; we keep it under ./storage.
STORAGE_ROOT=./storage
